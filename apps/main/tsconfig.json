{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts",
        "../setting/src/setting-page.tsx",
        "../map/src/map-view.tsx",
        "../chatroom/src/app/chat-panel.tsx",
        "../chatroom/src/app/room-view.tsx",
        "../chatroom/src/app/page.tsx",
        "../finding/src/finding-modal.tsx",
        "../borrow/src/borrow-modal.tsx"
    ],
    "exclude": ["node_modules"]
}
